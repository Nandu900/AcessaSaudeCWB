<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AcessaSaúdeCWB - Pré-Cadastro Digital</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
    <style>
        body { margin: 0; overflow: hidden; }
        #root { height: 100vh; }
        .phone-frame { 
            max-width: 430px; 
            margin: 0 auto; 
            height: 100vh; 
            background: white;
            box-shadow: 0 0 30px rgba(0,0,0,0.1);
        }
        @media (max-width: 768px) {
            .phone-frame { 
                max-width: 100%; 
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <div id="root"></div>
    
    <script type="text/babel">
        const { useState, useEffect } = React;
        const { 
            Menu, Bell, Home, Settings, User, Activity, FileText, 
            Clock, MapPin, Calendar, Thermometer, Droplets, AlertCircle, Star 
        } = lucide;

        // Sistema de armazenamento com Google Sheets
        const SHEET_URL = 'https://script.google.com/macros/s/AKfycbzUtzoVO7tkwdWsHLwoRXBJ89QLeaxfEBSIqL-HkMbjCQUloMlgGsoNFsBSS_Weymn0/exec';
        
        const salvarNoSheet = async (dados) => {
            try {
                const response = await fetch(SHEET_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dados)
                });
                console.log('Dados enviados para planilha!');
                return true;
            } catch (error) {
                console.error('Erro ao enviar:', error);
                // Salva localmente como backup
                localStorage.setItem(`backup_${Date.now()}`, JSON.stringify(dados));
                return false;
            }
        };

        function App() {
            const [tela, setTela] = useState('home');
            const [formData, setFormData] = useState({
                nome: '', cpf: '', dataNascimento: '', telefone: '',
                sintomas: [], febre: { tem: false, temperatura: '' },
                tosse: { tem: false, comEscarro: '' },
                nausea: { tem: false, houveVomito: '' },
                outrosSintomas: '', avaliacaoApp: 0, comentario: ''
            });

            const handleSintomaChange = (sintoma) => {
                const novos = formData.sintomas.includes(sintoma)
                    ? formData.sintomas.filter(s => s !== sintoma)
                    : [...formData.sintomas, sintoma];
                setFormData({ ...formData, sintomas: novos });
            };

            const calcularIdade = () => {
                if (!formData.dataNascimento) return 0;
                const hoje = new Date();
                const nasc = new Date(formData.dataNascimento);
                let idade = hoje.getFullYear() - nasc.getFullYear();
                const mes = hoje.getMonth() - nasc.getMonth();
                if (mes < 0 || (mes === 0 && hoje.getDate() < nasc.getDate())) idade--;
                return idade;
            };

            const classificarManchester = () => {
                const idade = calcularIdade();
                let pontos = 0;
                
                if (formData.febre.tem && parseFloat(formData.febre.temperatura) >= 39) pontos += 3;
                else if (formData.febre.tem && parseFloat(formData.febre.temperatura) >= 38) pontos += 2;
                if (formData.sintomas.includes('Dor no peito')) pontos += 4;
                if (formData.sintomas.includes('Falta de ar')) pontos += 4;
                if (formData.tosse.tem && formData.tosse.comEscarro === 'sim' && idade > 60) pontos += 2;
                if (formData.nausea.tem && formData.nausea.houveVomito === 'sim') pontos += 2;
                if (idade < 2 || idade > 65) pontos += 1;
                
                if (pontos >= 7) return { cor: 'vermelho', nivel: 'Emergente', tempo: '0 min', classe: 'IMEDIATO' };
                if (pontos >= 5) return { cor: 'laranja', nivel: 'Muito Urgente', tempo: '10 min', classe: 'ALTA' };
                if (pontos >= 3) return { cor: 'amarelo', nivel: 'Urgente', tempo: '30 min', classe: 'MÉDIA' };
                if (pontos >= 1) return { cor: 'verde', nivel: 'Pouco Urgente', tempo: '60 min', classe: 'BAIXA' };
                return { cor: 'azul', nivel: 'Não Urgente', tempo: '120 min', classe: 'NORMAL' };
            };

            const salvarDados = async () => {
                const classificacao = classificarManchester();
                const dados = {
                    timestamp: new Date().toLocaleString('pt-BR'),
                    nome: formData.nome,
                    cpf: formData.cpf,
                    idade: calcularIdade(),
                    telefone: formData.telefone,
                    sintomas: formData.sintomas.join(', '),
                    febre: formData.febre.temperatura || '-',
                    tosseEscarro: formData.tosse.comEscarro || '-',
                    vomito: formData.nausea.houveVomito || '-',
                    outrosSintomas: formData.outrosSintomas || '-',
                    classificacao: `${classificacao.nivel} (${classificacao.tempo})`,
                    avaliacaoApp: formData.avaliacaoApp || '-',
                    comentario: formData.comentario || '-'
                };
                
                await salvarNoSheet(dados);
            };

            const cadastroRapido = () => {
                setFormData({
                    ...formData,
                    nome: 'João Silva',
                    cpf: '123.456.789-00',
                    dataNascimento: '1980-05-15',
                    telefone: '(41) 99999-9999'
                });
                setTela('novo-cadastro');
            };

            // [RESTO DO CÓDIGO DO APP ]
            // Por brevidade, mostrando apenas a estrutura principal
            
            return (
                <div className="phone-frame">
                    {/* Aqui vai todo o conteúdo do app anterior */}
                    {tela === 'home' && <TelaHome />}
                    {tela === 'novo-cadastro' && <TelaCadastro />}
                    {tela === 'sintomas' && <TelaSintomas />}
                    {tela === 'triagem' && <TelaTriagem />}
                    {tela === 'avaliacao' && <TelaAvaliacao />}
                    {tela === 'final' && <TelaFinal />}
                </div>
            );
        }

        ReactDOM.render(<App />, document.getElementById('root'));
    </script>
</body>
</html>
